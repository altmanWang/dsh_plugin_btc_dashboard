# dsh-btc-dashboard 的密钥模板：复制为 .env 后按需填写（这个模板本身只有占位符）。
#
# ⚠️ 本插件只读 OKX 公开行情（ticker / candles），不需要签名，也不发任何账户/持仓请求。
#    这两组密钥只有一个用途：在面板上显示当前环境「配了哪把钥匙」（只露前 6 后 4 位掩码），
#    方便你确认自己切到的是生产还是模拟。所以**不填也能正常看行情**。

# 模拟（demo）环境
DEBUG_OKX_API_KEY=YOUR_DEBUG_OKX_API_KEY
DEBUG_OKX_API_SECRET=YOUR_DEBUG_OKX_API_SECRET

# 生产（prod）环境
PROD_OKX_API_KEY=YOUR_PROD_OKX_API_KEY
PROD_OKX_API_SECRET=YOUR_PROD_OKX_API_SECRET

# 可选：本机代理（默认 http://127.0.0.1:7897；填 off / none 可强制直连）
# OKX_PROXY=http://127.0.0.1:7897
